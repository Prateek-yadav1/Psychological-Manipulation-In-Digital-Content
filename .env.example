# ManipuLens AI - Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit .env to source control.

# Groq - primary LLM for analysis (OpenAI-compatible API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI - fallback LLM when Groq is unavailable
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Firecrawl - used by the Express server to extract webpage content from URLs
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Supabase - used by the Express server for persistent history storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Express server port
PORT=3001

# Allowed CORS origin - set to your frontend URL in production
ALLOWED_ORIGIN=http://localhost:5173

# Frontend (Vite)
# In development: leave empty so Vite dev proxy forwards /api/* to localhost:3001.
# In production: set to your deployed API URL, e.g. https://api.manipulens.ai
VITE_API_BASE_URL=
